$C = "../../Common.ui";

$C.@SmallSecondaryTextButton #TabButton {
  @Text = "";
  // The client's tab sound (Sounds.ui @DefaultTabNavigation). Passed to a Common.ui template: the file is also in
  // Custom/Sounds, in case the client resolves the path from Common.ui rather than from this page.
  @Sounds = (Activate: (SoundPath: "Sounds/DefaultTabActivate.ogg", Volume: -2, MinPitch: -0.2, MaxPitch: 0.2));
  Anchor: (Width: 150, Height: 30, Right: 4);
  TextTooltipStyle: $C.@DefaultTextTooltipStyle;
}
