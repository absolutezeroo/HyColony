$C = "../../Common.ui";
$Sounds = "../../Sounds.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 500);

    #Title {
      $C.@Title {
        @Text = %hycolony.ui.found.title;
      }
    }

    #Content {
      Padding: (Vertical: 32, Horizontal: 45);

      Label {
        Text: %hycolony.ui.found.name;
        Style: (RenderBold: true, RenderUppercase: true, TextColor: #94a7bb);
      }

      $C.@TextField #NameInput {
        Anchor: (Top: 10, Height: 44);
      }

      Group {
        LayoutMode: Center;
        Anchor: (Top: 8);

        $C.@TextButton #ConfirmButton {
          @Sounds = $Sounds.@SaveSettings;
          @Anchor = (Right: 4);
          Text: %hycolony.ui.found.confirm;
          FlexWeight: 1;
        }

        $C.@SecondaryTextButton #CancelButton {
          @Sounds = $Sounds.@ButtonsCancel;
          @Anchor = (Left: 4);
          Text: %hycolony.ui.found.cancel;
          FlexWeight: 1;
        }
      }
    }
  }
}

$C.@BackButton {}
