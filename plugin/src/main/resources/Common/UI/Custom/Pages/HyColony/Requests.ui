$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 700);

    #Title {
      $C.@Title {
        @Text = %hycolony.ui.requests.title;
      }
    }

    #Content {
      Padding: (Vertical: 24, Horizontal: 40);
      LayoutMode: Top;

      Label #Empty {
        Style: (TextColor: #94a7bb);
        Anchor: (Bottom: 10);
        Visible: false;
      }

      Group #Requests {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Anchor: (Height: 400);
      }
    }
  }
}

$C.@BackButton {}
