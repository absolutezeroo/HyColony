$P = "Parts.ui";
$B = "../Mc/Book.ui";
$C = "../../../Common.ui";

// The farmer hut's Fields page (MC gui/layouthuts/layoutfarmfields.xml, FarmFieldsModuleWindow), MC positions and
// sizes doubled: the header, "Assign fields to worker" with Manual / Automatic, "n/m fields in use", then the fields.

Group {
  Anchor: (Left: 0, Top: 0, Width: 380, Height: 488);

  $P.@Desc #Desc {}

  Label {
    Anchor: (Left: 26, Top: 58, Width: 328, Height: 22);
    Style: $B.@InkCentered;
    Text: %hycolony.ui.fields.assignmentMode;
  }

  TextButton #Mode {
    Anchor: (Left: 104, Top: 84, Width: 172, Height: 34);
    Style: $B.@MediumButtonDisabledTextureStyle;
    Text: "";
  }

  Label #Count {
    Anchor: (Left: 26, Top: 138, Width: 328, Height: 22);
    Style: $B.@InkCentered;
  }

  Group #Fields {
    Anchor: (Left: 26, Top: 164, Width: 328, Height: 290);
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
  }
}
