$B = "Book.ui";
$S = "Skills.ui";

// A line of the citizen's Job page (MC gui/citizen/job.xml), MC sizes doubled: the skill's small icon 22 x 22, then
// "Skill (n% XP)" 30 px to its right. Citizen.ui's #JobPrimary and #JobSecondary stack them at MC's heights.

Group {
  Anchor: (Width: 302, Height: 24);

  Group #Icon {
    Anchor: (Left: 0, Top: 0, Width: 22, Height: 22);

    $S.@SkillIcons #Icons {}
  }

  Label #Name {
    Anchor: (Left: 30, Top: 0, Width: 272, Height: 22);
    Style: $B.@Ink;
  }
}
