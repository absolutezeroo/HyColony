$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 560);

    #Title {
      $C.@Title {
        @Text = %hycolony.ui.field.title;
      }
    }

    #Content {
      Padding: (Vertical: 20, Horizontal: 32);
      LayoutMode: Top;

      Label #Farmer {
        Style: (RenderBold: true);
        Anchor: (Bottom: 8);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 40, Bottom: 8);

        ItemIcon #SeedIcon {
          Anchor: (Width: 32, Height: 32);
        }

        Label #SeedName {
          FlexWeight: 1;
          Padding: (Horizontal: 8);
        }
      }

      Group {
        LayoutMode: Center;
        Anchor: (Height: 40);

        $C.@SecondaryTextButton #North {
          Anchor: (Width: 60, Height: 32);
          Text: "";
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        }
      }

      Group {
        LayoutMode: Center;
        Anchor: (Height: 40);

        $C.@SecondaryTextButton #West {
          Anchor: (Width: 60, Height: 32, Right: 70);
          Text: "";
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        }

        $C.@SecondaryTextButton #East {
          Anchor: (Width: 60, Height: 32);
          Text: "";
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        }
      }

      Group {
        LayoutMode: Center;
        Anchor: (Height: 40, Bottom: 10);

        $C.@SecondaryTextButton #South {
          Anchor: (Width: 60, Height: 32);
          Text: "";
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        }
      }

      Label #PickLabel {
        Text: %hycolony.ui.field.seed;
        Style: (RenderBold: true, TextColor: #94a7bb);
        Anchor: (Bottom: 6);
      }

      Group #Seeds {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Anchor: (Height: 220);
      }
    }
  }
}

$C.@BackButton {}
