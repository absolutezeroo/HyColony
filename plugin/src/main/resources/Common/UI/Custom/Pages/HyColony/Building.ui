$C = "../../Common.ui";

// A hut's window as MC's (gui/layouthuts/*.xml), MC positions and sizes doubled: the builder paper, the open tab's
// page appended into #Page (Hut/*.ui), then the side tabs (MC TabsWindowModule) drawn over the paper's left edge.
// Textures under Mc/ are MineColonies' (ldtteam, GPL-3), scaled x4 nearest-neighbour into @2x files.

$C.@PageOverlay {
  LayoutMode: Middle;

  Group {
    Anchor: (Width: 420, Height: 488);

    Group {
      Anchor: (Left: 40, Top: 0, Width: 380, Height: 488);
      Background: "Mc/builder_paper.png";
    }

    Group #Page {
      Anchor: (Left: 40, Top: 0, Width: 380, Height: 488);
    }

    // MC TAB_Y_OFFSET 10 and TAB_HEIGHT + TAB_Y_SPACING 28, doubled: SideTab.ui is 56 high, its tab 52.
    Group #Tabs {
      Anchor: (Left: 0, Top: 20, Width: 64, Height: 468);
      LayoutMode: Top;
    }
  }
}

$C.@BackButton {}
