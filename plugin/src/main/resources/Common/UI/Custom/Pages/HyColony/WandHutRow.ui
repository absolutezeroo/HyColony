$C = "../../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 40);

  ItemIcon #Icon {
    Anchor: (Width: 32, Height: 32);
  }

  Label #Name {
    FlexWeight: 1;
    Padding: (Horizontal: 8);
    Style: (TextColor: #ffffff);
  }

  $C.@SecondaryTextButton #ChooseButton {
    Anchor: (Width: 120, Height: 32);
    Text: %hycolony.ui.wand.choose;
  }
}
