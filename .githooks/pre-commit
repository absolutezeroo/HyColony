#!/bin/sh
# Fast gate (CLAUDE.md § 3, § 8): formatting, file/package sizes, section dividers, Java lines over 120 columns.
# Skipped when no staged file can affect these checks (docs-only commits stay instant).
relevant=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(java|kts|kt)$|^gradle/|^config/|^build-logic/|(^|/)gradle\.properties$')
if [ -z "$relevant" ]; then
    exit 0
fi
# Gradle checks the working tree, not the index: a staged file that also has unstaged changes would be checked in a
# state that is not the one committed.
partial=$(git diff --name-only | grep -Fx -e "$relevant")
if [ -n "$partial" ]; then
    echo "pre-commit: these staged files also have unstaged changes, so the checks would not see what is committed:" >&2
    printf '  %s\n' $partial >&2
    echo "Stage them fully (git add <path>) or set the unstaged part aside, then commit again." >&2
    exit 1
fi
if ! ./gradlew spotlessCheck checkFileSizes checkSectionDividers checkLineLength --quiet; then
    echo >&2
    echo "pre-commit: checks failed. Format your files one by one" >&2
    echo "(./gradlew :<module>:spotlessApply -PspotlessIdeHook=\"<absolute path>\": other sessions may share the module)," >&2
    echo "wrap lines over 120 columns, split oversized files/packages, remove section dividers, then commit again." >&2
    echo "Never bypass with --no-verify (CLAUDE.md § 10)." >&2
    exit 1
fi
