$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 700);

    #Title {
      $C.@Title {
        @Text = %hycolony.ui.resources.title;
      }
    }

    #Content {
      Padding: (Vertical: 24, Horizontal: 40);
      LayoutMode: Top;

      Label #Progress {
        Style: (TextColor: #94a7bb);
        Anchor: (Bottom: 10);
      }

      Label #Empty {
        Style: (TextColor: #94a7bb);
        Anchor: (Bottom: 10);
        Visible: false;
      }

      Group #Resources {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Anchor: (Height: 400);
      }

      $C.@SecondaryTextButton #HutButton {
        @Anchor = (Top: 8);
        Text: %hycolony.ui.resources.backToHut;
      }
    }
  }
}

$C.@BackButton {}
