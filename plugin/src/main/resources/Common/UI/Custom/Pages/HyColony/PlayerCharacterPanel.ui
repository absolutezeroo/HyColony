$C = "../../Common.ui";

// The player's character panel, laid out as Hytale's own (client CharacterPanel.ui): character, armor and utility
// slots. Textures under Native/ are copied from the Hytale client (see docs/native-ui-textures.md).

@Slot = 74;
@GridY = 50;
@GridStyle = (SlotSize: @Slot, SlotIconSize: 64, SlotSpacing: 2, SlotBackground: "Native/Slot.png");
@SpecialStyle = (SlotSize: @Slot, SlotIconSize: 64, SlotSpacing: 2, SlotBackground: "Native/SpecialSlot.png");
@ArmorIcon = Group {
  @Row = 0;

  HitTestVisible: false;
  Anchor: (Width: 64, Height: 64, Left: 7, Top: @GridY + 7 + 76 * @Row);
};

$C.@DecoratedContainer #PlayerCharacterPanel {
  Anchor: (Width: 410, Height: 560);

  #Title {
    $C.@Title #PlayerName {
      @Text = "";
    }
  }

  #Content {
    LayoutMode: Top;

    Group {
      Anchor: (Height: 490, Top: -8);

      Group {
        Anchor: (Width: 420, Height: 396, Bottom: -50);
        Background: "Native/CharacterBackground.png";
      }

      CharacterPreviewComponent #PlayerCharacter {
        Anchor: (Height: 365, Top: 0, Left: -8, Right: -8);
        Padding: (Left: 78, Right: 78);
      }

      ItemGrid #PlayerArmor {
        Anchor: (Width: 78, Height: 310, Left: 0, Top: @GridY);
        SlotsPerRow: 1;
        AreItemsDraggable: true;
        RenderItemQualityBackground: true;
        Style: @GridStyle;
        Padding: 2;
      }

      // Drawn over the armor grid, shown only on an empty slot, as the client does; clicks go through.
      @ArmorIcon #ArmorIconHead { @Row = 0; Background: "Native/ArmorSlotIconHead.png"; }
      @ArmorIcon #ArmorIconChest { @Row = 1; Background: "Native/ArmorSlotIconChest.png"; }
      @ArmorIcon #ArmorIconHands { @Row = 2; Background: "Native/ArmorSlotIconHands.png"; }
      @ArmorIcon #ArmorIconLegs { @Row = 3; Background: "Native/ArmorSlotIconLegs.png"; }

      // All 4 utility slots (PlayerSystems gives the player 4), where the client shows only the active one: with
      // ItemStacks a grid shows every slot of its section, and hiding some would hide the items in them.
      ItemGrid #PlayerUtility {
        Anchor: (Width: 306, Height: 78, Left: 35, Bottom: 0);
        SlotsPerRow: 4;
        AreItemsDraggable: true;
        RenderItemQualityBackground: true;
        Style: @SpecialStyle;
        Padding: 2;
      }
    }
  }
}
