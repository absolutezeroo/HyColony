$C = "../../Common.ui";

Button #ShapeButton {
  LayoutMode: Center;
  Anchor: (Width: 54, Height: 54, Right: 4, Bottom: 4);
  Style: $C.@SecondaryButtonStyle;
  TextTooltipStyle: $C.@DefaultTextTooltipStyle;

  ItemIcon #Icon {
    Anchor: (Width: 42, Height: 42);
  }

  // While this shape's variant in the slots' materials is being created (vanilla Common.ui spinner).
  $C.@DefaultSpinner #Spinner {
    Visible: false;
  }
}
