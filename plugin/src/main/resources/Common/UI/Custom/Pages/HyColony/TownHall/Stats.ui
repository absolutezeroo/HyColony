$B = "../Mc/Book.ui";
$C = "../../../Common.ui";

// The town hall's Statistics tab (MC layoutstats.xml), MC positions doubled: the population on the left page.

Group {
  Anchor: (Left: 0, Top: 0, Width: 1048, Height: 486);

  Label #TotalCitizens {
    Anchor: (Left: 200, Top: 122, Width: 296, Height: 22);
    Style: (...$B.@Ink, RenderBold: true);
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }

  Group #StatLines {
    Anchor: (Left: 200, Top: 166, Width: 296, Height: 272);
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
  }
}
