$B = "../Mc/Book.ui";
$C = "../../../Common.ui";
$Sounds = "../../../Sounds.ui";

// The town hall's Home tab (MC layoutactions.xml, WindowMainPage), MC positions and sizes doubled. Deviation from
// MC: no town map, mercenaries, flag, colour nor Patreon (no such systems); the Town Map's place stays empty.

@Label = Label {
  Style: $B.@Ink;
};

Group {
  Anchor: (Left: 0, Top: 0, Width: 1048, Height: 486);

  Label {
    Anchor: (Left: 200, Top: 48, Width: 296, Height: 22);
    Text: %hycolony.ui.townhall.colonyName;
    Style: (...$B.@Ink, TextColor: #008000);
  }

  Button #RenameButton {
    Anchor: (Left: 200, Top: 64, Width: 30, Height: 30);
    Style: (Default: (Background: "../Mc/edit.png"), Sounds: $C.@ButtonSounds);
    TooltipText: %hycolony.ui.townhall.edit;
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }

  Label #ColonyName {
    Anchor: (Left: 240, Top: 70, Width: 296, Height: 22);
    Style: (...$B.@Ink, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 10);
  }

  TextButton #BuildButton {
    Anchor: (Left: 220, Top: 194, Width: 258, Height: 34);
    Style: (
      ...$B.@WideButtonStyle,
      Default: (Background: "../Mc/builder_button_medium_large_build.png", LabelStyle: $B.@InkCentered),
      Hovered: (
        Background: "../Mc/builder_button_medium_large_build.png",
        LabelStyle: (...$B.@InkCentered, RenderBold: true)
      ),
      Pressed: (Background: "../Mc/builder_button_medium_large_build.png", LabelStyle: $B.@InkCentered)
    );
    Text: "";
  }

  Label {
    Anchor: (Left: 560, Top: 70, Width: 258, Height: 22);
    Text: %hycolony.ui.townhall.cosmetic;
    Style: (...$B.@InkCentered, RenderBold: true);
  }

  @Label { Anchor: (Left: 538, Top: 216, Width: 296, Height: 22); Text: %hycolony.ui.townhall.colonyPack; }

  DropdownBox #ColonyPack {
    Anchor: (Left: 674, Top: 210, Width: 172, Height: 34);
    Style: $B.@MediumDropdownStyle;
  }

  @Label { Anchor: (Left: 538, Top: 336, Width: 296, Height: 22); Text: %hycolony.ui.townhall.citizenStyle; }

  Group {
    Anchor: (Left: 674, Top: 330, Width: 172, Height: 34);
    Background: "../Mc/builder_button_medium_disabled.png";

    Label {
      Text: %hycolony.ui.townhall.defaultPack;
      Style: $B.@InkCentered;
    }
  }

  @Label { Anchor: (Left: 538, Top: 386, Width: 296, Height: 22); Text: %hycolony.ui.townhall.namePack; }

  Group {
    Anchor: (Left: 674, Top: 380, Width: 172, Height: 34);
    Background: "../Mc/builder_button_medium_disabled.png";

    Label {
      Text: %hycolony.ui.townhall.defaultPack;
      Style: $B.@InkCentered;
    }
  }
}
