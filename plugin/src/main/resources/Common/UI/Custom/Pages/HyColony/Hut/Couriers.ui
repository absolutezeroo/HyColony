$P = "Parts.ui";
$B = "../Mc/Book.ui";

// The warehouse's Couriers page (MC gui/layouthuts/layoutcourierassignment.xml, SpecialAssignmentModuleWindow), MC
// positions and sizes doubled: "Assigned Workers:" (MC workerhuts.workerassigned), the couriers, Manage Workers and
// Recall Worker.

Group {
  Anchor: (Left: 0, Top: 0, Width: 380, Height: 488);

  Label {
    Anchor: (Left: 26, Top: 44, Width: 328, Height: 22);
    Style: (...$B.@InkCentered, RenderBold: true);
    Text: %hycolony.ui.hut.workersAssigned;
  }

  $P.@List #Couriers { @Top = 86; @Height = 220; }

  $P.@WideButton #Hire { @Top = 308; Text: %hycolony.ui.hut.manageWorkers; }
  $P.@WideButton #Recall { @Top = 344; Text: %hycolony.ui.hut.recallWorker; }
}
