$C = "../../Common.ui";
$B = "Mc/Book.ui";

// A hut's help (MC gui/windowinfo.xml, WindowInfo), MC positions and sizes doubled: the paper, a short title strip,
// one page at a time (its red name and its text), the page arrows (the left one leaves on the first page) and
// "n/m".

@Arrow = Button {
  @Left = 0;

  Anchor: (Left: @Left, Top: 26, Width: 36, Height: 20);
};

$C.@PageOverlay {
  LayoutMode: Middle;

  Group {
    Anchor: (Width: 380, Height: 488);
    Background: "Mc/builder_paper.png";

    Group {
      Anchor: (Left: 88, Top: 24, Width: 12, Height: 30);
      Background: "Mc/builder_sketch_left.png";
    }

    Group {
      Anchor: (Left: 100, Top: 24, Width: 180, Height: 30);
      Background: "Mc/builder_sketch_center.png";
    }

    Group {
      Anchor: (Left: 280, Top: 24, Width: 12, Height: 30);
      Background: "Mc/builder_sketch_right.png";
    }

    Label #Name {
      Anchor: (Left: 100, Top: 28, Width: 180, Height: 22);
      Style: (...$B.@InkCentered, TextColor: #ff0000);
    }

    Label #Text {
      Anchor: (Left: 40, Top: 60, Width: 300, Height: 388);
      Style: (FontSize: 14, TextColor: #000000, Wrap: true, VerticalAlignment: Start);
    }

    @Arrow #Prev {
      @Left = 26;
      Style: (Default: (Background: "Mc/turn_page_left.png"), Sounds: $C.@ButtonSounds);
    }

    @Arrow #Next {
      @Left = 318;
      Style: (Default: (Background: "Mc/turn_page_right.png"), Sounds: $C.@ButtonSounds);
    }

    Label #PageNum {
      Anchor: (Left: 316, Top: 444, Width: 40, Height: 22);
      Style: $B.@InkCentered;
    }
  }
}

$C.@BackButton {}
