$C = "../../Common.ui";
$B = "Mc/Book.ui";

// The recipes a crafting hut could learn, opened by Teach Recipe. Deviation from MC: MC opens a crafting grid where the
// player lays the recipe out; HyColony lists the game's recipes the hut can hold, each with Learn, on MC's paper.

$C.@PageOverlay {
  LayoutMode: Middle;

  Group {
    Anchor: (Width: 380, Height: 488);
    Background: "Mc/builder_paper.png";

    Label {
      Anchor: (Left: 60, Top: 28, Width: 260, Height: 22);
      Style: $B.@InkCentered;
      Text: %hycolony.ui.recipes.teach;
    }

    Label #Empty {
      Anchor: (Left: 40, Top: 80, Width: 300, Height: 22);
      Style: $B.@InkCentered;
      Text: %hycolony.ui.recipes.none;
      Visible: false;
    }

    Group #Recipes {
      Anchor: (Left: 40, Top: 80, Width: 323, Height: 330);
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }

    TextButton #Back {
      Anchor: (Left: 100, Top: 430, Width: 172, Height: 34);
      Style: $B.@MediumButtonStyle;
      Text: %hycolony.ui.building.options.back;
    }
  }
}

$C.@BackButton {}
