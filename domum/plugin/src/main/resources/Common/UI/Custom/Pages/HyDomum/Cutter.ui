$C = "../../Common.ui";
$Sounds = "../../Sounds.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  // As the client's InventoryPage.ui (TotalPageContentWidth): a side panel's room on both sides, so that the centre
  // column, the bench, sits in the middle of the screen. The right one stays empty (the client's item info panel).
  Group {
    LayoutMode: Left;
    Anchor: (Width: 1611);

    Group #Character {
      Anchor: (Width: 410);
    }

    Group {
      LayoutMode: Top;
      Anchor: (Width: 715, Left: 38);

      $C.@Container {
        Anchor: (Width: 715, Height: 480);

        #Title {
          $C.@Title {
            @Text = %hydomum.ornament.cutter.title;
          }
        }

        #Content {
          LayoutMode: Top;

          Group #TabButtons {
            LayoutMode: Left;
            Anchor: (Height: 58, Bottom: 6);
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 360);

            Group {
              LayoutMode: Top;
              Anchor: (Width: 330);

              Label #GroupName {
                Anchor: (Height: 32);
                Style: (RenderBold: true, FontSize: 15, TextColor: #afc2c3, VerticalAlignment: Center);
              }

              Group #Shapes {
                LayoutMode: LeftCenterWrap;
                FlexWeight: 1;
                Padding: (Top: 6);
              }
            }

            $C.@VerticalSeparator {}

            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Padding: (Left: 10);

              Label #ShapeName {
                Anchor: (Height: 32);
                Style: (RenderBold: true, FontSize: 15, TextColor: #afc2c3, VerticalAlignment: Center);
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 200, Top: 4);

                // The ingredients, as the client's crafting panels show them: a slot turns green with its check once
                // it holds a material its tag accepts. Placed absolutely: the backgrounds sit under the grid's slots.
                Group {
                  Anchor: (Width: 84, Height: 200);

                  Group #SlotBg0 {
                    Anchor: (Width: 72, Height: 72, Left: 3, Top: 3);
                    Background: (TexturePath: "../HyBlockUI/Native/IngredientSlot.png", Border: 24);
                  }

                  // A slot the recipe still needs: the client's invalid slot (DiagramCraftingPanel SlotPatchInvalid).
                  Group #SlotBad0 {
                    Anchor: (Width: 72, Height: 72, Left: 3, Top: 3);
                    Background: (TexturePath: "../HyBlockUI/Native/DiagramCraftingSlotInvalid.png", Border: 24);
                    Visible: false;
                  }

                  Group #SlotOk0 {
                    Anchor: (Width: 72, Height: 72, Left: 3, Top: 3);
                    Background: (TexturePath: "../HyBlockUI/Native/IngredientSlotValid.png", Border: 24);
                    Visible: false;
                  }

                  Group #SlotBg1 {
                    Anchor: (Width: 72, Height: 72, Left: 3, Top: 101);
                    Background: (TexturePath: "../HyBlockUI/Native/IngredientSlot.png", Border: 24);
                  }

                  // A slot the recipe still needs: the client's invalid slot (DiagramCraftingPanel SlotPatchInvalid).
                  Group #SlotBad1 {
                    Anchor: (Width: 72, Height: 72, Left: 3, Top: 101);
                    Background: (TexturePath: "../HyBlockUI/Native/DiagramCraftingSlotInvalid.png", Border: 24);
                    Visible: false;
                  }

                  Group #SlotOk1 {
                    Anchor: (Width: 72, Height: 72, Left: 3, Top: 101);
                    Background: (TexturePath: "../HyBlockUI/Native/IngredientSlotValid.png", Border: 24);
                    Visible: false;
                  }

                  ItemGrid #CutterSlots {
                    Anchor: (Width: 78, Height: 176, Left: 0, Top: 0);
                    SlotsPerRow: 1;
                    AreItemsDraggable: true;
                    DisplayItemQuantity: true;
                    RenderItemQualityBackground: false;
                    Style: (SlotSize: 72, SlotIconSize: 60, SlotSpacing: 26);
                    Padding: 3;
                  }

                  Label #SlotLabel0 {
                    Anchor: (Width: 78, Height: 20, Left: 0, Top: 76);
                    Style: (FontSize: 12, TextColor: #819395, HorizontalAlignment: Center);
                  }

                  Label #SlotLabel1 {
                    Anchor: (Width: 78, Height: 20, Left: 0, Top: 174);
                    Style: (FontSize: 12, TextColor: #819395, HorizontalAlignment: Center);
                  }
                }

                Group {
                  LayoutMode: Top;
                  FlexWeight: 1;

                  Group {
                    LayoutMode: Center;
                    Anchor: (Height: 170);

                    // The variant turning in 3D, as the client's bench preview (ItemPreviewComponent).
                    ItemPreviewComponent #Preview {
                      Anchor: (Width: 180, Height: 170);
                    }

                    // While the previewed variant is being created (vanilla Common.ui spinner).
                    $C.@DefaultSpinner #PreviewSpinner {
                      Visible: false;
                    }
                  }

                  Label #PreviewText {
                    Anchor: (Height: 30);
                    Style: (TextColor: #ffffff, Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                  }
                }
              }

              // Fills while a craft takes its time (HyDomum.CutterCraftSeconds), as the client's bench bar.
              $C.@ProgressBar #CraftProgress {
                Anchor: (Height: 6, Top: 6);
                Value: 0;
              }

              $C.@TextButton #CraftButton {
                @Text = %hydomum.ornament.cutter.craft;
                @Sounds = $Sounds.@SaveSettings;
                Anchor: (Height: 44, Top: 8);
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 32, Top: 6);

                $C.@SmallSecondaryTextButton #Craft10Button {
                  @Text = %hydomum.ornament.cutter.craft10;
                  FlexWeight: 1;
                }

                Group {
                  Anchor: (Width: 5);
                }

                $C.@SmallSecondaryTextButton #CraftAllButton {
                  @Text = %hydomum.ornament.cutter.craftAll;
                  FlexWeight: 1;
                }
              }
            }
          }
        }
      }

      Group #Storage {
        Anchor: (Top: 8);
      }
    }

    Group {
      Anchor: (Width: 410, Left: 38);
    }
  }
}
