$C = "../../Common.ui";
$B = "Mc/Book.ui";

// The citizen's window as MC's (gui/citizen/nav.xml, main.xml, job.xml, requests.xml), MC positions and sizes
// doubled: the side tabs, then the colonist paper drawn over their right edge as nav.xml does, then each tab's page
// (CitizenPage shows the open one). MC's tab backgrounds are fixed by nav.xml; Family keeps its empty place (a system
// HyColony lacks). The Inventory tab opens the game's container screen instead (CitizenPage).
// Textures under Mc/ are MineColonies' (ldtteam, GPL-3), except the wax seals and tab icons, ours, drawn in its style
// by tools/ui/seals.py and tools/ui/tabs.py; all are scaled x4 nearest-neighbour into @2x files.

@TabBack = Group {
  @Y = 0;

  Anchor: (Left: 0, Top: @Y, Width: 64, Height: 52);
};

@TabIcon = Group {
  @Y = 0;

  Anchor: (Left: 10, Top: @Y, Width: 40, Height: 40);
};

@TabHit = Button {
  @Y = 0;

  Anchor: (Left: 0, Top: @Y, Width: 40, Height: 52);
  Style: (Default: (Background: #000000(0)), Sounds: $C.@ButtonSounds);
  TextTooltipStyle: $C.@DefaultTextTooltipStyle;
};

@Page = Group {
  Anchor: (Left: 0, Top: 0, Width: 420, Height: 488);
  Visible: false;
};

$C.@PageOverlay {
  LayoutMode: Middle;

  Group {
    LayoutMode: Top;
    Anchor: (Width: 420);

    Group {
      Anchor: (Width: 420, Height: 488);

      @TabBack { @Y = 72; Background: "Mc/tab_left_side1.png"; }
      @TabIcon { @Y = 78; Background: "Mc/info.png"; }
      @TabBack { @Y = 128; Background: "Mc/tab_left_side2.png"; }
      @TabIcon { @Y = 134; Background: "Mc/requests.png"; }
      @TabBack { @Y = 184; Background: "Mc/tab_left_side3.png"; }
      @TabIcon { @Y = 190; Background: "Mc/inventory.png"; }
      @TabBack { @Y = 236; Background: "Mc/tab_left_side2.png"; }
      @TabIcon { @Y = 242; Background: "Mc/happiness.png"; }

      Group #JobTab {
        Anchor: (Left: 0, Top: 0, Width: 64, Height: 488);
        Visible: false;

        @TabBack { @Y = 340; Background: "Mc/tab_left_side3.png"; }
        @TabIcon { @Y = 346; Background: "Mc/main.png"; }
      }

      Group {
        Anchor: (Left: 40, Top: 0, Width: 380, Height: 488);
        Background: "Mc/colonist_paper.png";
      }

      @TabHit #MainHit { @Y = 72; TooltipText: %hycolony.ui.citizen.tab.main; }
      @TabHit #RequestsHit { @Y = 128; TooltipText: %hycolony.ui.citizen.requests; }
      @TabHit #InventoryHit { @Y = 184; TooltipText: %hycolony.ui.citizen.tab.inventory; }
      @TabHit #HappinessHit { @Y = 236; TooltipText: %hycolony.ui.citizen.tab.happiness; }
      @TabHit #JobHit { @Y = 340; TooltipText: %hycolony.ui.citizen.tab.job; Visible: false; }

      @Page #MainPage {
        Label #Name {
          Anchor: (Left: 66, Top: 28, Width: 328, Height: 22);
          Style: $B.@InkCentered;
        }

        Group {
          Anchor: (Left: 148, Top: 58, Width: 164, Height: 32);
          Background: "Mc/colonist_text_decor_down.png";
        }

        Group #Hearts {
          Anchor: (Left: 130, Top: 104, Width: 200, Height: 18);
          LayoutMode: Left;
        }

        Label #HealthLabel {
          Anchor: (Left: 380, Top: 104, Width: 60, Height: 22);
          Style: $B.@Ink;
        }

        Group #Food {
          Anchor: (Left: 130, Top: 126, Width: 200, Height: 18);
          LayoutMode: Left;
        }

        Group #Smileys {
          Anchor: (Left: 130, Top: 146, Width: 200, Height: 18);
          LayoutMode: Left;
        }

        // Kept at the user's request (MC's window has none): the job and workplace, then the activity, under MC's
        // happiness bar; the skills start 16 px lower than MC's to make room.
        Label #JobLine {
          Anchor: (Left: 66, Top: 164, Width: 328, Height: 16);
          Style: (...$B.@InkCentered, FontSize: 12);
        }

        Label #Activity {
          Anchor: (Left: 66, Top: 180, Width: 328, Height: 16);
          Style: (...$B.@InkCentered, FontSize: 12);
        }

        Group #Skills {
          Anchor: (Left: 110, Top: 196, Width: 210, Height: 270);
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }

        Group {
          Anchor: (Left: 354, Top: 418, Width: 30, Height: 98);
          Background: "Mc/colonist_decor_up_ribbon_smaller.png";
        }

        Group #Male {
          Anchor: (Left: 340, Top: 408, Width: 60, Height: 60);
          Background: "Mc/colonist_wax_male_smaller.png";
        }

        Group #Female {
          Anchor: (Left: 340, Top: 408, Width: 60, Height: 60);
          Background: "Mc/colonist_wax_female_smaller.png";
          Visible: false;
        }
      }

      @Page #RequestsPage {
        Label {
          Anchor: (Left: 66, Top: 28, Width: 328, Height: 22);
          Style: $B.@InkCentered;
          Text: %hycolony.ui.citizen.requests;
        }

        Group #Tree {
          Anchor: (Left: 66, Top: 58, Width: 316, Height: 368);
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }

      // MC happiness.xml: the title at (45, 32), then MC's rows from y 62 every 12
      // (CitizenWindowUtils.updateHappiness).
      @Page #HappinessPage {
        Label {
          Anchor: (Left: 90, Top: 64, Width: 272, Height: 22);
          Style: $B.@InkCentered;
          Text: %hycolony.ui.happiness.modifiers;
        }

        Group #HappinessRows {
          Anchor: (Left: 90, Top: 124, Width: 300, Height: 340);
          LayoutMode: Top;
        }
      }

      @Page #JobPage {
        Label #JobLabel {
          Anchor: (Left: 90, Top: 64, Width: 272, Height: 22);
          Style: $B.@InkCentered;
        }

        Label {
          Anchor: (Left: 100, Top: 88, Width: 300, Height: 60);
          Style: (...$B.@Ink, Wrap: true);
          Text: %hycolony.ui.citizen.jobDesc;
        }

        Group #JobPrimary {
          Anchor: (Left: 100, Top: 148, Width: 302, Height: 72);
          LayoutMode: Top;
        }

        Group #JobSecondary {
          Anchor: (Left: 100, Top: 248, Width: 302, Height: 72);
          LayoutMode: Top;
        }
      }
    }
  }
}

$C.@BackButton {}
