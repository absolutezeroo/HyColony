// One smiley of the citizen's happiness bar (MC CitizenWindowUtils.createHappinessBar), MC sizes doubled: an
// 18 x 18 smiley every 20 px, from MC's citizen/icons.png (x 16 empty, 52 red, 61 half red). HappinessBar gives each
// slot: the empty smiley under a full or half red one.

@Layer = Group {
  Anchor: (Full: 0);
  Visible: false;
};

Group {
  Anchor: (Width: 20, Height: 18);

  Group {
    Anchor: (Left: 0, Top: 0, Width: 18, Height: 18);
    Background: "smiley_empty.png";

    @Layer #Full { Background: "smiley_red.png"; }
    @Layer #Half { Background: "smiley_half_red.png"; }
  }
}
