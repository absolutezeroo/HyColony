$C = "../../Common.ui";
$Sounds = "../../Sounds.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@Container {
    Anchor: (Width: 900, Height: 700);

    #Title {
      $C.@Title {
        @Text = %hycolony.ornament.cutter.title;
      }
    }

    #Content {
      LayoutMode: Top;

      Group #TabButtons {
        LayoutMode: Left;
        Anchor: (Height: 58, Bottom: 6);
      }

      Group {
        LayoutMode: Left;
        FlexWeight: 1;

        Group {
          LayoutMode: Top;
          Anchor: (Width: 470);

          Label #GroupName {
            Anchor: (Height: 32);
            Style: (RenderBold: true, FontSize: 15, TextColor: #afc2c3, VerticalAlignment: Center);
          }

          Group #Shapes {
            LayoutMode: LeftCenterWrap;
            FlexWeight: 1;
            Padding: (Top: 6);
          }
        }

        $C.@VerticalSeparator {}

        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Padding: (Left: 10);

          Label #ShapeName {
            Anchor: (Height: 32);
            Style: (RenderBold: true, FontSize: 15, TextColor: #afc2c3, VerticalAlignment: Center);
          }

          Group #Slots {
            LayoutMode: Top;
            Padding: (Top: 6);
          }

          Group {
            LayoutMode: Center;
            Anchor: (Height: 110, Top: 6);

            ItemIcon #Preview {
              Anchor: (Width: 96, Height: 96);
            }
          }

          Label #PreviewText {
            Anchor: (Height: 60);
            Style: (TextColor: #ffffff, Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center);
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 44, Top: 6);

            $C.@TextButton #CraftButton {
              @Text = %hycolony.ornament.cutter.craft;
              @Sounds = $Sounds.@SaveSettings;
              FlexWeight: 1;
            }

            $C.@SecondaryTextButton #Craft10Button {
              @Text = %hycolony.ornament.cutter.craft10;
              Anchor: (Width: 90, Left: 6);
            }

            $C.@SecondaryTextButton #CraftAllButton {
              @Text = %hycolony.ornament.cutter.craftAll;
              Anchor: (Width: 90, Left: 6);
            }
          }
        }
      }

      Label {
        Anchor: (Height: 32, Top: 8);
        Style: (RenderBold: true, FontSize: 15, TextColor: #afc2c3, VerticalAlignment: Center);
        Text: %hycolony.ornament.cutter.materials;
      }

      Label #NoMaterials {
        Anchor: (Height: 24, Top: 6);
        Style: (TextColor: #96a9be);
        Text: %hycolony.ornament.cutter.noMaterials;
      }

      Group #Materials {
        LayoutMode: LeftCenterWrap;
        Anchor: (Height: 124);
        Padding: (Top: 6);
      }
    }
  }
}
