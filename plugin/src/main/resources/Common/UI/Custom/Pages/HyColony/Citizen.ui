$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 700);

    #Title {
      $C.@Title {
        @Text = %hycolony.ui.citizen.title;
      }
    }

    #Content {
      Padding: (Vertical: 24, Horizontal: 40);
      LayoutMode: Top;

      Group #TabButtons {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 12);
      }

      Group #MainTab {
        LayoutMode: Top;

        Label #Name {
          Style: (FontSize: 22, RenderBold: true);
        }

        Label #Job {
          Style: (TextColor: #94a7bb);
          Anchor: (Top: 4);
        }

        Label #Workplace {
          Style: (TextColor: #94a7bb);
          Anchor: (Top: 2);
        }

        Label #Activity {
          Style: (RenderBold: true);
          Anchor: (Top: 6, Bottom: 10);
        }

        Label {
          Text: %hycolony.ui.citizen.skills;
          Style: (RenderBold: true, RenderUppercase: true, TextColor: #94a7bb);
          Anchor: (Bottom: 6);
        }

        Group #Skills {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 300);
        }
      }

      Group #RequestsTab {
        LayoutMode: Top;
        Visible: false;

        Label #RequestsEmpty {
          Style: (TextColor: #94a7bb);
          Visible: false;
        }

        Group #Requests {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 400);
        }
      }

      Group #InventoryTab {
        LayoutMode: Top;
        Visible: false;

        $C.@SecondaryTextButton #OpenInventoryButton {
          @Anchor = (Bottom: 10);
          Text: %hycolony.ui.citizen.openInventory;
        }

        Label #InventoryEmpty {
          Style: (TextColor: #94a7bb);
          Visible: false;
        }

        Group #Inventory {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 400);
        }
      }

      Group #JobTab {
        LayoutMode: Top;
        Visible: false;

        Label #JobLabel {
          Style: (FontSize: 18, RenderBold: true);
        }

        Label {
          Text: %hycolony.ui.citizen.jobDesc;
          Style: (TextColor: #94a7bb);
          Anchor: (Top: 4, Bottom: 10);
        }

        Group #JobPrimary {
          LayoutMode: Top;
          Anchor: (Bottom: 16);
        }

        Group #JobSecondary {
          LayoutMode: Top;
        }
      }
    }
  }
}

$C.@BackButton {}
