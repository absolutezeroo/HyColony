$B = "Book.ui";
$C = "../../../Common.ui";

// A citizen of the town hall's list (MC layoutcitizens.xml citizenList view), MC sizes doubled: a button with the
// citizen's name, disabled for the selected one, its skills in the tooltip.

Group {
  Anchor: (Height: 34);

  TextButton #Name {
    Anchor: (Left: 18, Top: 0, Width: 258, Height: 34);
    Style: (
      ...$B.@WideButtonStyle,
      Disabled: (Background: "builder_button_medium_large_disabled.png", LabelStyle: $B.@InkCentered)
    );
    Text: "";
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }
}
