$C = "../../../Common.ui";
$B = "Book.ui";

// One modifier of the citizen's Happiness tab (MC CitizenWindowUtils.updateHappiness), MC sizes doubled: its mood
// icon (22 x 22 at x 0, MC 11 x 11 at 45) then its name (MC at 70), one row every 24 px (MC 12). The icon's tooltip
// tells the mood, the name's the modifier's description. One mood layer is shown (HappinessRows.Mood).

@Mood = Group {
  Anchor: (Full: 0);
  Visible: false;
};

Group {
  Anchor: (Height: 24);

  Group #Icon {
    Anchor: (Left: 0, Top: 0, Width: 22, Height: 22);
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;

    @Mood #Positive { Background: "happy_icon.png"; }
    @Mood #Neutral { Background: "satisfied_icon.png"; }
    @Mood #SlightlyNegative { Background: "unsatisfied_icon.png"; }
    @Mood #Negative { Background: "unhappy_icon.png"; }
  }

  Label #Name {
    Anchor: (Left: 50, Top: 0, Width: 272, Height: 22);
    Style: $B.@Ink;
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }
}
