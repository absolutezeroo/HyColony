#!/bin/sh
# CLAUDE.md § 9.5: "type(scope): description" or "type: description", in English.
subject=$(sed -n '/^[^#]/{p;q;}' "$1")
case "$subject" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|refactor|test|docs|build|style|chore|perf)(\([a-z0-9._/-]+\))?: [^ ]'; then
    echo "commit-msg: subject must be 'type(scope): description' or 'type: description'" >&2
    echo "  type: feat|fix|refactor|test|docs|build|style|chore|perf" >&2
    echo "  got:  $subject" >&2
    exit 1
fi
