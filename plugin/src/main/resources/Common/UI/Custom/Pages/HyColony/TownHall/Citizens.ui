$B = "../Mc/Book.ui";
$C = "../../../Common.ui";

// The town hall's Citizens tab (MC layoutcitizens.xml, WindowCitizenPage), MC positions and sizes doubled: on the left
// page the colony's happiness and its modifiers; on the right the selected citizen's job, gender seal, health,
// happiness and saturation, its recall button, the search field, then the citizens by name. Deviation from MC: no
// citizen render (no such Hytale widget).

@Short = LabelStyle(...$B.@Ink, FontSize: 11, HorizontalAlignment: End);

Group {
  Anchor: (Left: 0, Top: 0, Width: 1048, Height: 486);

  Label #HappinessTitle {
    Anchor: (Left: 200, Top: 122, Width: 240, Height: 22);
    Style: $B.@InkCentered;
  }

  Group #HappinessList {
    Anchor: (Left: 200, Top: 166, Width: 296, Height: 272);
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
  }

  Label #Health {
    Anchor: (Left: 542, Top: 94, Width: 70, Height: 16);
    Style: @Short;
  }

  Group {
    Anchor: (Left: 612, Top: 92, Width: 18, Height: 18);
    Background: "../Mc/heart_red.png";
  }

  Label #HappinessLevel {
    Anchor: (Left: 632, Top: 94, Width: 50, Height: 16);
    Style: @Short;
  }

  Group {
    Anchor: (Left: 682, Top: 92, Width: 18, Height: 18);
    Background: "../Mc/smiley_red.png";
  }

  Label #Saturation {
    Anchor: (Left: 702, Top: 94, Width: 50, Height: 16);
    Style: @Short;
  }

  Group {
    Anchor: (Left: 752, Top: 92, Width: 18, Height: 18);
    Background: "../Mc/full.png";
  }

  Label #Job {
    Anchor: (Left: 552, Top: 56, Width: 240, Height: 22);
    Style: (...$B.@InkCentered, RenderBold: true);
  }

  Group #Male {
    Anchor: (Left: 792, Top: 56, Width: 22, Height: 22);
    Background: "../Mc/colonist_wax_male_smaller.png";
    Visible: false;
  }

  Group #Female {
    Anchor: (Left: 792, Top: 56, Width: 22, Height: 22);
    Background: "../Mc/colonist_wax_female_smaller.png";
    Visible: false;
  }

  TextButton #RecallButton {
    Anchor: (Left: 612, Top: 140, Width: 172, Height: 34);
    Style: (
      ...$B.@WideButtonStyle,
      Default: (Background: "../Mc/builder_button_medium.png", LabelStyle: $B.@InkCentered),
      Hovered: (
        Background: "../Mc/builder_button_medium_hover.png",
        LabelStyle: (...$B.@InkCentered, RenderBold: true)
      ),
      Pressed: (Background: "../Mc/builder_button_medium_hover.png", LabelStyle: $B.@InkCentered)
    );
    Text: %hycolony.ui.townhall.recallOne;
    Visible: false;
  }

  $C.@TextField #Search {
    @Anchor = (Left: 570, Top: 180, Width: 258);
    MaxLength: 32;
    TooltipText: %hycolony.ui.townhall.citizenFilter;
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }

  Group #CitizenList {
    Anchor: (Left: 552, Top: 220, Width: 296, Height: 212);
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
  }
}
